      "expected": { "artists": [], "title": "Radio Edit", "versions": [], "warnings": ["noSeparator"] },
      "rules": ["R6.2", "R8.2"],
      "tags": ["dash-suffix", "negative"],
      "note": "Without any spaced dash there is nothing to peel; unbracketed version words stay in the title"
    },
    {
