        "position": null,
        "timestamp": null,
        "artists": [
          { "name": "The Beatles", "role": "primary", "joiner": null, "source": "artist" }
        ],
        "title": "Hey Jude",
        "fullTitle": "Hey Jude - Remastered 2015",
        "versions": [
          {
            "type": "remaster",
            "raw": "Remastered 2015",
            "artists": [],
            "modifiers": [],
            "descriptor": null,
            "year": 2015,
            "unknownArtist": false,
            "delimiter": "-"
          }
        ],
        "year": null,
        "flags": { "explicit": false, "clean": false, "unknownArtist": false, "unknownTitle": false },
        "junk": [],
        "warnings": []
      },
      "rules": ["R6.2", "R6.3", "R5.7"],
      "tags": ["dash-suffix", "remaster", "exact"]
    },
    {
      "id": "dash-suffix-003",
      "input": "Strobe - Radio Edit",
      "expected": {
