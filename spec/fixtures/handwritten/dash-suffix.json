{
  "$schema": "../../schema/fixture-file.schema.json",
  "description": "R6.2 / R8.2 dash-suffix peeling: versions, junk, flags and years after a trailing spaced dash",
  "defaults": { "fn": "parse", "options": { "mode": "clean" } },
  "cases": [
    {
      "id": "dash-suffix-001",
      "input": "Hey Jude - Remastered 2015",
      "match": "exact",
      "expected": {
        "input": "Hey Jude - Remastered 2015",
        "mode": "clean",
        "position": null,
        "timestamp": null,
        "artists": [],
        "title": "Hey Jude",
        "fullTitle": "Hey Jude - Remastered 2015",
        "versions": [
          {
            "type": "remaster",
            "raw": "Remastered 2015",
            "artists": [],
            "modifiers": [],
            "descriptor": null,
            "year": 2015,
            "unknownArtist": false,
            "delimiter": "-"
          }
        ],
        "year": null,
        "flags": { "explicit": false, "clean": false, "unknownArtist": false, "unknownTitle": false },
        "junk": [],
        "warnings": ["noSeparator"]
      },
      "rules": ["R6.2", "R5.7", "R6.8", "R9.4"],
      "tags": ["dash-suffix", "remaster", "exact"],
      "note": "Peeled by condition (ii) (>= 2 words). Only one segment remains, so R6.8 applies and warns noSeparator. The version's year does not set top-level year."
    },
    {
      "id": "dash-suffix-002",
      "input": "The Beatles - Hey Jude - Remastered 2015",
