            "delimiter": "("
          }
        ],
        "year": null,
        "flags": { "explicit": false, "clean": false, "unknownArtist": false, "unknownTitle": false },
        "junk": [],
        "warnings": []
      },
      "rules": ["R5.7", "R9.4"],
      "tags": ["cyrillic", "remix"],
      "note": "Lowercase 'remix' head; raw keeps the case as written."
