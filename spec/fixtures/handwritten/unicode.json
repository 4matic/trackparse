      },
      "rules": ["R5.7", "R7.4"],
      "tags": ["cyrillic", "vip"],
      "note": "The apostrophe inside the name is not a wrapping quote."
    },
    {
      "id": "unicode-004",
      "input": "Кино - Кукушка (Ремикс)",
      "expected": { "artists": ["Кино"], "title": "Кукушка (Ремикс)", "versions": [] },
      "rules": ["R5.8"],
      "tags": ["cyrillic", "limitation"],
      "note": "Vocabulary is ASCII only: Cyrillic 'Ремикс' is not a version head, the group stays verbatim."
    },
    {
      "id": "unicode-005",
      "input": "Кино - Звезда по имени Солнце (1989)",
