      "tags": ["cyrillic", "year"]
    },
    {
      "id": "unicode-006",
      "input": "Баста & Гуф - Заколоченное",
      "expected": {
        "artists": [
          { "name": "Баста", "joiner": null },
          { "name": "Гуф", "joiner": "&" }
