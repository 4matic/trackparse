      "input": "BTS （방탄소년단） - Spring Day",
      "expected": { "artists": ["BTS (방탄소년단)"], "title": "Spring Day" },
      "rules": ["R1.3", "R7.1", "R5.8"],
      "tags": ["cjk", "korean", "brackets"],
      "note": "Fullwidth parentheses normalize to ASCII; an Unknown group on the artist side stays in the name."
    },
    {
      "id": "unicode-020",
      "input": "ONE OK ROCK - The Beginning（Official Music Video）",
      "expected": {
        "artists": ["ONE OK ROCK"],
