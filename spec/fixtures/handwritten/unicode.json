      "rules": ["R1.1", "R5.5"],
      "tags": ["nfd", "cyrillic"],
      "note": "Decomposed 'и + U+0306' composes to 'й'. An unbracketed trailing number is not a year."
    },
    {
      "id": "unicode-015",
      "input": "Sigur Rós - Svefn-g-englar",
      "expected": { "artists": ["Sigur Rós"], "title": "Svefn-g-englar" },
      "rules": ["R1.1"],
      "tags": ["nfd"]
    },
    {
