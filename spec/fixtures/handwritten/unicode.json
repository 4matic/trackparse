      "input": "宇多田ヒカル「First Love」",
      "options": { "mode": "youtube" },
      "expected": { "artists": ["宇多田ヒカル"], "title": "First Love", "warnings": ["quotedTitleSplit"] },
      "rules": ["R1.4", "R6.5"],
      "tags": ["cjk", "quoted"],
      "note": "Corner brackets map to '\"' and become a quoted-title split in youtube mode."
    },
    {
      "id": "unicode-018",
      "input": "방탄소년단 - 봄날",
      "expected": { "artists": ["방탄소년단"], "title": "봄날" },
      "rules": ["R6.3"],
      "tags": ["cjk", "korean"]
    },
    {
