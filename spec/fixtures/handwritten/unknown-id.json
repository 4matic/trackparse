        "artists": [],
        "title": "ID",
        "flags": { "unknownArtist": true, "unknownTitle": true }
      },
      "rules": ["R7.2", "R7.5", "R8.6"],
      "tags": ["id", "feat"]
    },
    {
      "id": "unknown-id-013",
      "input": "Noisia & ID - ID",
      "match": "exact",
      "expected": {
        "input": "Noisia & ID - ID",
        "mode": "clean",
        "position": null,
        "timestamp": null,
        "artists": [
          { "name": "Noisia", "role": "primary", "joiner": null, "source": "artist" }
        ],
        "title": "ID",
        "fullTitle": "ID",
        "versions": [],
        "year": null,
        "flags": { "explicit": false, "clean": false, "unknownArtist": true, "unknownTitle": true },
        "junk": [],
        "warnings": []
      },
      "rules": ["R7.5", "R8.6"],
      "tags": ["id"],
      "note": "A known collaborator plus an unknown one: the ID is dropped, the flag is set."
    },
    {
      "id": "unknown-id-014",
      "input": "Unknown - Unknown",
      "expected": {
        "artists": [],
        "title": "Unknown",
        "flags": { "unknownArtist": true, "unknownTitle": true }
      },
      "rules": ["R7.5", "R8.6"],
      "tags": ["unknown"]
    },
    {
      "id": "unknown-id-015",
      "input": "Unknown Artist - Unknown Title",
      "expected": {
        "artists": [],
        "title": "Unknown Title",
        "flags": { "unknownArtist": true, "unknownTitle": true }
      },
      "rules": ["R7.5", "R8.6"],
      "tags": ["unknown"]
    },
    {
      "id": "unknown-id-016",
      "input": "Burial - Untitled (VIP)",
      "expected": {
        "artists": ["Burial"],
