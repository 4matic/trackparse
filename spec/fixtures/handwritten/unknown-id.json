      "input": "Noisia - Tentacles (ID Remix)",
      "expected": {
        "artists": ["Noisia"],
        "title": "Tentacles",
        "versions": [{ "type": "remix", "raw": "ID Remix", "artists": [], "unknownArtist": true }],
        "flags": { "unknownArtist": false, "unknownTitle": false }
      },
      "rules": ["R5.7"],
      "tags": ["id", "remix"]
    },
    {
      "id": "unknown-id-018",
      "input": "Noisia - Tentacles (ID VIP)",
      "expected": {
        "artists": ["Noisia"],
        "title": "Tentacles",
        "versions": [{ "type": "vip", "raw": "ID VIP", "artists": [], "unknownArtist": true }]
      },
      "rules": ["R5.7"],
      "tags": ["id", "vip"]
    },
    {
      "id": "unknown-id-019",
      "input": "Noisia - ID Theft",
      "expected": {
        "artists": ["Noisia"],
        "title": "ID Theft",
        "flags": { "unknownTitle": false }
      },
      "rules": ["R8.6"],
      "tags": ["id"],
      "note": "Only a title that is entirely an unknown token is flagged."
    },
    {
      "id": "unknown-id-020",
      "input": "Noisia - Tentacles (feat. ID)",
      "expected": {
        "artists": [{ "name": "Noisia", "role": "primary" }],
        "title": "Tentacles",
        "flags": { "unknownArtist": true }
      },
      "rules": ["R5.2", "R7.5"],
      "tags": ["id", "feat"],
      "note": "An unknown featured credit outside versions sets flags.unknownArtist."
    },
    {
      "id": "unknown-id-021",
      "input": "Noisia - ?",
      "expected": {
        "artists": ["Noisia"],
        "title": "?",
        "flags": { "unknownTitle": true }
      },
      "rules": ["R8.6"],
      "tags": ["unknown"]
    },
    {
      "id": "unknown-id-022",
      "input": "ID - ID - ID",
      "expected": {
        "artists": [],
        "title": "ID - ID",
        "versions": [],
        "flags": { "unknownArtist": true, "unknownTitle": false }
      },
      "rules": ["R6.3", "R8.2", "R8.6"],
      "tags": ["id"],
      "note": "Later dashes stay in the title; 'ID - ID' as a whole is not an unknown token."
    },
    {
      "id": "unknown-id-023",
      "input": "ID - ID (Official Video)",
      "options": { "mode": "auto" },
      "expected": {
        "mode": "youtube",
        "artists": [],
        "title": "ID",
        "junk": [{ "raw": "Official Video", "kind": "video" }],
        "flags": { "unknownArtist": true, "unknownTitle": true }
      },
      "rules": ["R2.1", "R5.1", "R7.5", "R8.6"],
      "tags": ["id", "junk"]
    },
    {
      "id": "unknown-id-024",
      "input": "untitled - Burial",
      "expected": {
        "artists": [],
        "title": "Burial",
        "flags": { "unknownArtist": true, "unknownTitle": false }
      },
      "rules": ["R7.5"],
      "tags": ["unknown", "case"],
      "note": "'untitled' is a caseInsensitive unknown token, also on the artist side."
    },
    {
      "id": "unknown-id-025",
      "input": "Noisia - Stigma (feat. ID)",
      "expected": {
        "artists": ["Noisia"],
        "title": "Stigma",
        "flags": { "unknownArtist": true }
      },
      "rules": ["R7.5", "R5.2"],
      "tags": ["feat"],
      "note": "An unknown token in a feat credit sets flags.unknownArtist."
    },
    {
      "id": "unknown-id-026",
      "input": "Noisia - Stigma prod. by ???",
      "expected": {
        "artists": ["Noisia"],
        "title": "Stigma",
        "flags": { "unknownArtist": true }
      },
      "rules": ["R7.5", "R8.3"],
      "tags": ["producer"]
