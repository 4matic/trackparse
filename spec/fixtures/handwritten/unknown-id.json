{
  "$schema": "../../schema/fixture-file.schema.json",
  "description": "Unknown/unreleased placeholders: ID artists (R7.5), ID titles (R8.6), ID remixers (R5.7) and the resulting flags",
  "defaults": { "fn": "parse", "options": { "mode": "clean" } },
  "cases": [
    {
      "id": "unknown-id-001",
      "input": "ID - ID",
      "match": "exact",
      "expected": {
        "input": "ID - ID",
        "mode": "clean",
        "position": null,
        "timestamp": null,
        "artists": [],
        "title": "ID",
        "fullTitle": "ID",
        "versions": [],
        "year": null,
        "flags": { "explicit": false, "clean": false, "unknownArtist": true, "unknownTitle": true },
        "junk": [],
        "warnings": []
      },
      "rules": ["R7.5", "R8.6"],
      "tags": ["id", "dnb"]
    },
    {
      "id": "unknown-id-002",
      "input": "ID - Carbon",
      "expected": {
        "artists": [],
        "title": "Carbon",
        "flags": { "unknownArtist": true, "unknownTitle": false }
      },
      "rules": ["R7.5"],
      "tags": ["id"]
    },
    {
      "id": "unknown-id-003",
      "input": "Noisia - ID",
      "expected": {
        "artists": ["Noisia"],
        "title": "ID",
        "flags": { "unknownArtist": false, "unknownTitle": true }
      },
      "rules": ["R8.6"],
      "tags": ["id"]
    },
    {
      "id": "unknown-id-004",
      "input": "Noisia - ID (ID Remix)",
      "match": "exact",
      "expected": {
        "input": "Noisia - ID (ID Remix)",
        "mode": "clean",
        "position": null,
        "timestamp": null,
        "artists": [
          { "name": "Noisia", "role": "primary", "joiner": null, "source": "artist" }
        ],
        "title": "ID",
        "fullTitle": "ID (ID Remix)",
        "versions": [
          {
            "type": "remix",
            "raw": "ID Remix",
            "artists": [],
            "modifiers": [],
            "descriptor": null,
            "year": null,
            "unknownArtist": true,
            "delimiter": "("
          }
        ],
        "year": null,
        "flags": { "explicit": false, "clean": false, "unknownArtist": false, "unknownTitle": true },
        "junk": [],
        "warnings": []
      },
      "rules": ["R5.7", "R8.6", "R7.5"],
      "tags": ["id", "remix"],
      "note": "An unknown remixer sets version.unknownArtist, not flags.unknownArtist."
    },
    {
      "id": "unknown-id-005",
      "input": "Unknown Artist - Nightcall",
      "expected": {
        "artists": [],
        "title": "Nightcall",
        "flags": { "unknownArtist": true, "unknownTitle": false }
      },
      "rules": ["R7.5"],
      "tags": ["unknown"]
    },
    {
      "id": "unknown-id-006",
      "input": "??? - ???",
      "expected": {
        "artists": [],
        "title": "???",
        "flags": { "unknownArtist": true, "unknownTitle": true }
      },
      "rules": ["R7.5", "R8.6"],
      "tags": ["unknown"]
    },
    {
      "id": "unknown-id-007",
      "input": "Burial - Untitled",
      "expected": {
        "artists": ["Burial"],
        "title": "Untitled",
        "flags": { "unknownArtist": false, "unknownTitle": true }
      },
      "rules": ["R8.6"],
      "tags": ["unknown"]
    },
    {
      "id": "unknown-id-008",
      "input": "Noisia & Phace - IDs",
      "expected": {
        "artists": ["Noisia", "Phace"],
        "title": "IDs",
        "flags": { "unknownTitle": true }
