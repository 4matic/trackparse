        "artists": ["Noisia"],
        "title": "ID?",
        "flags": { "unknownTitle": true }
      },
      "rules": ["R8.6"],
      "tags": ["id"]
    },
    {
      "id": "unknown-id-010",
      "input": "Fred again.. - id",
      "expected": {
        "artists": ["Fred again.."],
        "title": "id",
        "flags": { "unknownArtist": false, "unknownTitle": false }
      },
      "rules": ["R8.6", "R7.4"],
      "tags": ["id", "case"],
      "note": "'ID' is caseSensitive: lowercase 'id' is a real title."
    },
    {
      "id": "unknown-id-011",
      "input": "ID - ID (Noisia Remix)",
      "expected": {
        "artists": [],
        "title": "ID",
