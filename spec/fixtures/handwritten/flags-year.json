        "title": "Stigma",
        "year": 2015
      },
      "rules": ["R7.5", "R9.6"],
      "tags": ["year", "artist-side"],
      "note": "A dropped year-only name sets the track year."
    },
    {
      "id": "flags-year-034",
      "input": "Noisia - Stigma [2016] - 1999",
      "expected": {
        "artists": ["Noisia"],
        "title": "Stigma",
        "year": 2016
      },
      "rules": ["R9.6", "R6.2", "R8.1"],
      "tags": ["year", "order"],
      "note": "First year in text order wins."
    }
