      "rules": ["R11.2"],
      "tags": ["feat"]
    },
    {
      "id": "format-007",
      "input": "Sub Focus ft. Alice Gold - Out the Blue",
      "formatOptions": { "feat": "omit" },
      "expected": "Sub Focus - Out the Blue",
      "rules": ["R11.2"],
      "tags": ["feat"]
    },
    {
      "id": "format-008",
      "input": "Sub Focus ft. Alice Gold & Kele - Out the Blue",
