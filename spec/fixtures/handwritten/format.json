      "expected": "Sub Focus ft. Alice Gold - Out the Blue",
      "rules": ["R11.2"],
      "tags": ["feat"]
    },
    {
      "id": "format-006",
      "input": "Sub Focus ft. Alice Gold - Out the Blue",
