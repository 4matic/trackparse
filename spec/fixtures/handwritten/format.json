{
  "$schema": "../../schema/fixture-file.schema.json",
  "description": "format(parse(input)) with formatOptions (R11): defaults, feat placement, featMarker, canonical joiners, versions, producers, position",
  "defaults": { "fn": "format", "options": { "mode": "clean" } },
  "cases": [
    {
      "id": "format-001",
      "input": "Noisia - Tentacles",
      "expected": "Noisia - Tentacles",
      "rules": ["R11.4"],
      "tags": ["defaults", "round-trip"]
    },
    {
      "id": "format-002",
      "input": "Sub Focus ft. Alice Gold & Kele - Out the Blue (Wilkinson Remix)",
      "expected": "Sub Focus ft. Alice Gold & Kele - Out the Blue (Wilkinson Remix)",
      "rules": ["R11.1", "R11.2", "R11.3"],
      "tags": ["defaults", "round-trip", "feat"]
    },
    {
      "id": "format-003",
      "input": "Noisia & The Upbeats vs Phace, Mefjus - Dead Limit",
      "expected": "Noisia & The Upbeats vs Phace, Mefjus - Dead Limit",
      "rules": ["R11.1"],
      "tags": ["defaults", "round-trip", "joiner"],
      "note": "Constructed credits. ',' renders as ', ' (no space before)."
    },
    {
      "id": "format-004",
      "input": "Sub Focus - Out the Blue ft. Alice Gold",
      "expected": "Sub Focus - Out the Blue (ft. Alice Gold)",
      "rules": ["R11.2"],
      "tags": ["feat", "source"],
      "note": "feat 'source': title-sourced featured credits go into a title group."
    },
    {
      "id": "format-005",
      "input": "Sub Focus - Out the Blue ft. Alice Gold",
