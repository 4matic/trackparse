      "rules": [
        "R1.7"
      ],
      "tags": [
        "multiplication-sign"
      ],
      "note": "U+00D7 is a joiner and must survive normalization"
    },
    {
      "id": "normalization-024",
      "input": "   Sub   Focus    -   Timewarp   ",
      "expected": "Sub Focus - Timewarp",
      "rules": [
