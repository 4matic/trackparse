{
  "$schema": "../../schema/fixture-file.schema.json",
  "description": "R1 normalization: normalize() output for Unicode/whitespace/dash/bracket/quote noise, plus parse() cases proving that noise does not change results",
  "defaults": {
    "fn": "normalize",
    "options": {
      "mode": "clean"
    }
  },
  "cases": [
    {
      "id": "normalization-001",
      "input": "Beyoncé - Halo",
      "expected": "Beyoncé - Halo",
      "rules": [
        "R1.1"
      ],
      "tags": [
        "nfc"
      ],
      "note": "Decomposed e + combining acute composes to U+00E9"
    },
    {
      "id": "normalization-002",
      "input": "Мумий Тролль - Утекай",
      "expected": "Мумий Тролль - Утекай",
      "rules": [
        "R1.1"
      ],
      "tags": [
        "nfc",
        "cyrillic"
      ],
      "note": "Cyrillic и + U+0306 combining breve composes to й"
    },
    {
      "id": "normalization-003",
      "input": "Noi​sia‌ - Sti‍gma⁠",
      "expected": "Noisia‌ - Sti‍gma",
      "rules": [
        "R1.2"
      ],
      "tags": [
        "zero-width"
      ],
      "note": "U+200B and U+2060 are removed; U+200C (ZWNJ) and U+200D (ZWJ) are kept (R1.2)."
    },
    {
      "id": "normalization-004",
      "input": "﻿Noisia - Stigma",
      "expected": "Noisia - Stigma",
      "rules": [
        "R1.2"
      ],
      "tags": [
        "zero-width",
        "bom"
      ]
    },
    {
      "id": "normalization-005",
      "input": "Mef­jus - Sinkhole",
      "expected": "Mefjus - Sinkhole",
      "rules": [
        "R1.2"
      ],
      "tags": [
        "soft-hyphen"
      ],
      "note": "U+00AD soft hyphen is removed, not mapped to a dash"
    },
    {
      "id": "normalization-006",
      "input": "Noisia -\tStigma",
      "expected": "Noisia - Stigma",
      "rules": [
        "R1.6",
        "R0.2"
      ],
      "tags": [
        "whitespace",
        "nbsp"
      ]
    },
    {
      "id": "normalization-007",
      "input": "　Sub Focus  - Timewarp\r\n",
      "expected": "Sub Focus - Timewarp",
      "rules": [
        "R1.6",
        "R0.2"
      ],
      "tags": [
        "whitespace"
      ],
      "note": "Ideographic space, thin space, narrow NBSP, CR/LF all map to U+0020, collapse, trim"
    },
    {
      "id": "normalization-008",
      "input": "Noisia – Stigma",
      "expected": "Noisia - Stigma",
      "rules": [
        "R1.5"
      ],
      "tags": [
        "dash",
        "en-dash"
      ]
    },
    {
      "id": "normalization-009",
      "input": "Noisia — Stigma",
      "expected": "Noisia - Stigma",
      "rules": [
        "R1.5"
      ],
      "tags": [
        "dash",
        "em-dash"
      ]
    },
    {
      "id": "normalization-010",
      "input": "Noisia ‒ Stigma ― VIP",
      "expected": "Noisia - Stigma - VIP",
      "rules": [
        "R1.5"
      ],
      "tags": [
        "dash",
        "figure-dash"
      ],
      "note": "U+2012 figure dash and U+2015 horizontal bar"
    },
    {
      "id": "normalization-011",
      "input": "Noisia − Stigma",
      "expected": "Noisia - Stigma",
      "rules": [
        "R1.5"
      ],
      "tags": [
        "dash",
        "minus"
      ]
    },
    {
      "id": "normalization-012",
      "input": "Jay‐Z ﹣ Numb﹘Encore － Live",
      "expected": "Jay-Z - Numb-Encore - Live",
      "rules": [
        "R1.5"
      ],
      "tags": [
        "dash"
      ],
      "note": "U+2010 hyphen, U+FE63 small hyphen-minus, U+FE58 small em dash, U+FF0D fullwidth hyphen-minus"
    },
    {
      "id": "normalization-013",
      "input": "Noisia -- Stigma",
      "expected": "Noisia - Stigma",
      "rules": [
        "R1.5"
      ],
      "tags": [
        "dash",
        "double-dash"
      ]
    },
    {
      "id": "normalization-014",
      "input": "Noisia --- Stigma —— VIP",
      "expected": "Noisia - Stigma - VIP",
      "rules": [
        "R1.5"
      ],
      "tags": [
        "dash",
        "double-dash"
      ],
      "note": "Two em dashes become '--' first, then the spaced run collapses"
    },
    {
      "id": "normalization-015",
      "input": "Track--Name",
      "expected": "Track--Name",
      "rules": [
        "R1.5"
      ],
      "tags": [
        "dash"
      ],
      "note": "Dash runs not surrounded by whitespace are kept"
    },
    {
      "id": "normalization-016",
      "input": "Noisia - Stigma （Mefjus Remix）",
      "expected": "Noisia - Stigma (Mefjus Remix)",
      "rules": [
        "R1.3"
      ],
      "tags": [
        "fullwidth"
      ]
    },
    {
