{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/4matic/trackparse/spec/schema/options.schema.json",
  "title": "Options",
  "$defs": {
    "parseOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "auto",
            "clean",
            "youtube",
            "filename",
            "tracklist"
          ],
          "default": "auto"
        },
        "uploader": {
          "type": "string",
          "description": "youtube mode: channel name used as artist when no separator is found."
        },
        "knownArtists": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Names that must never be split (e.g. 'Chase & Status')."
        },
        "splitAnd": {
          "enum": [
            "auto",
            "always",
            "never"
          ],
          "default": "auto"
        },
        "keywords": {
          "type": "object",
          "additionalProperties": false,
          "description": "Extensions to the built-in vocabulary (additive only in v1).",
          "properties": {
            "versionHeads": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "descriptors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "genres": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "junk": {
              "type": "object",
              "additionalProperties": {
                "enum": [
                  "video",
                  "audio",
                  "lyrics",
                  "quality",
                  "promo",
                  "platform",
                  "label",
                  "genre",
                  "other"
                ]
              }
            },
            "featMarkers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "formatOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "feat": {
          "enum": [
            "source",
            "artist",
            "title",
            "omit"
          ],
          "default": "source"
        },
        "featMarker": {
          "type": "string"
        },
        "joiners": {
          "enum": [
            "original",
            "canonical"
          ],
          "default": "original"
        },
        "versions": {
          "enum": [
            "all",
            "none"
          ],
          "default": "all"
        },
        "producers": {
          "type": "boolean",
          "default": true
        },
        "position": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "tracklistOptions": {
      "type": "object",
      "additionalProperties": false,
      "description": "R13.10: options of parseTracklist and applyEdits.",
      "properties": {
        "mode": {
          "enum": [
            "auto",
            "clean",
            "youtube",
            "filename",
            "tracklist"
          ],
          "default": "tracklist"
        },
        "knownArtists": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Names that must never be split (e.g. 'Chase & Status')."
        },
        "splitAnd": {
          "enum": [
            "auto",
            "always",
            "never"
          ],
          "default": "auto"
        },
        "keywords": {
          "type": "object",
          "additionalProperties": false,
          "description": "Extensions to the built-in vocabulary (additive only in v1).",
          "properties": {
            "versionHeads": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "descriptors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "genres": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "junk": {
              "type": "object",
              "additionalProperties": {
                "enum": [
                  "video",
                  "audio",
                  "lyrics",
                  "quality",
                  "promo",
                  "platform",
                  "label",
                  "genre",
                  "other"
                ]
              }
            },
            "featMarkers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "audioSeconds": {
          "type": "number",
          "minimum": 0,
          "description": "Length of the audio; enables time-after-audio-end."
        },
        "markerWords": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Extra R13.3 marker words."
        }
      }
    },
    "edit": {
      "description": "R13.9: one edit for applyEdits.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "line",
            "seconds"
          ],
          "properties": {
            "op": {
              "const": "set-time"
            },
            "line": {
              "type": "integer"
            },
            "seconds": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "seconds"
          ],
          "properties": {
            "op": {
              "const": "shift"
            },
            "seconds": {
              "type": "number"
            },
            "lines": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "from": {
              "type": "integer"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op"
          ],
          "properties": {
            "op": {
              "const": "sort-by-time"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "line",
            "rest"
          ],
          "properties": {
            "op": {
              "const": "set-rest"
            },
            "line": {
              "type": "integer"
            },
            "rest": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "after",
            "text"
          ],
          "properties": {
            "op": {
              "const": "insert"
            },
            "after": {
              "type": "integer"
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "line"
          ],
          "properties": {
            "op": {
              "const": "delete"
            },
            "line": {
              "type": "integer"
            }
          }
        }
      ]
    }
  }
}
