---
import ArrowDownWideNarrow from "@lucide/astro/icons/arrow-down-wide-narrow";
import Copy from "@lucide/astro/icons/copy";
import Timer from "@lucide/astro/icons/timer";
import Redo2 from "@lucide/astro/icons/redo-2";
import Undo2 from "@lucide/astro/icons/undo-2";
import { fieldUrl, textFragment as frag } from "../lib/trackview";
import "../styles/playground.css";

// Docs links next to the controls they explain.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const doc = (path: string) => `${base}/${path}`;
// Each option name links to its row in an options table: the JavaScript name, then the Python
// and Rust name and the Go name in the next cells, so the text fragment finds that row only.
const opt = (js: string, py: string, go: string, section = "") => doc(`reference/options/#${section}${frag(py, go, js)}`);
const ref = {
  mode: opt("mode", "mode", "Mode"),
  splitAnd: opt("splitAnd", "split_and", "SplitAnd"),
  knownArtists: opt("knownArtists", "known_artists", "KnownArtists"),
  uploader: opt("uploader", "uploader", "Uploader"),
  audioSeconds: opt("audioSeconds", "audio_seconds", "AudioSeconds", "tracklist-options"),
  // The format options are listed in the formatting guide, name then values.
  feat: doc(`guides/formatting/#options${frag("feat", '"source"')}`),
  joiners: doc(`guides/formatting/#options${frag("joiners", '"original"')}`),
  versions: doc(`guides/formatting/#options${frag("versions", '"all"')}`),
  shift: doc(`reference/tracklist/#edits${frag("Edit::shift_from")}`),
  edits: doc("guides/editing-tracklists/#the-edits"),
};
// The tracklist table's columns: entry fields in reference/tracklist, track fields in reference/parse.
const entry = (field: string, type: string) => doc(`reference/tracklist/#tracklistentry${frag(field, type)}`);
const columns: { label: string; href: string; title: string }[] = [
  { label: "#", href: entry("line", "number"), title: "line: the 1-based line number" },
  { label: "kind", href: entry("kind", '"track"'), title: "kind: what the line is" },
  { label: "time", href: entry("time", "{ raw"), title: "time: the start time" },
  { label: "artists", href: fieldUrl(base, "artists"), title: "track.artists" },
  { label: "title", href: fieldUrl(base, "title"), title: "track.title" },
  { label: "versions", href: fieldUrl(base, "versions"), title: "track.versions" },
];

const trackExamples = [
  "01. Wilkinson ft. Becky Hill & Tom Cane - Afterglow (Sub Focus VIP Remix) [Official Video]",
  "Dimension - Offshore (Mefjus Remix / Noisia Remix)",
  "Pendulum - Watercolour (Extended VIP Mix)",
  "Taylor Swift - Love Story (Taylor's Version)",
  "Daft Punk - One More Time (Official Music Video) [HD]",
  "[12:34] Noisia - Stigma",
  '"Numb" by Linkin Park',
  "Chase & Status x Camo & Krooked - Track (Alix Perez Rerub)",
  "Mumford & Sons - Little Lion Man",
  "2 Unlimited - No Limit",
];

const sample = [
  "Hour 2",
  "48:20 Noisia - Stigma",
  "52:47 Mefjus & Kasra - Bandwagon (Phace Remix)",
  "56:05 Black Sun Empire - ID",
  "59:31 Alix Perez - Fade Away",
  "01:03:10 Interview with Hybris",
  "01:07:44 Imanu - Sacrifice",
  "00:11:02 Current Value feat. Teddy Killerz - Payload",
  "01:15:36 Hybris - Spinning Top",
].join("\n");

// Example tracklists for the Tracklist tab, each showing one thing the parser does.
const listExamples: { label: string; title: string; text: string }[] = [
  { label: "Podcast hour", title: "A podcast hour with one time out of order and a suggested fix", text: sample },
  {
    // Pasted from a chat or a comment: list bullets, Markdown emphasis and a layered `w/` line.
    label: "Markdown",
    title: "Pasted from a chat: list bullets, bold and italics, a w/ line",
    text: [
      "**Tracklist**",
      "* 00:00 Noisia - Stigma",
      "* 03:30 **Phace** - Psycho",
      "**[**07:10**] 3. Mefjus - Sleepless**",
      "w/ Hybris - Spinning Top (Acapella)",
      "[10:45] Imanu - _Sacrifice_",
      "* 14:20 Black Sun Empire - ID",
    ].join("\n"),
  },
  {
    label: "YouTube chapters",
    title: "Chapters with an intro and an outro marker",
    text: ["0:00 Intro", "1:45 Noisia - Stigma", "5:10 Phace - Psycho (VIP)", "9:02 Mefjus - Sleepless", "12:40 Outro"].join("\n"),
  },
  {
    label: "No dots",
    title: "Track numbers without dots: 1 Artist - Title",
    text: [
      "1 Dropzone - Pyramid",
      "2 Gydra - Bassquake",
      "3 Redpill & Coppa - Undercover",
      "4 Linkin Park_-_Points Of Authority (Gydra Bootleg)",
    ].join("\n"),
  },
  {
    label: "Long mix",
    title: "Minutes past 59 without hours: 125:30",
    text: ["0:00 Noisia - Stigma", "58:40 Phace - Psycho", "61:15 Mefjus - Sleepless", "125:30 Imanu - Sacrifice"].join("\n"),
  },
];
---

<div class="pg not-content" data-base={base}>
  <div class="pg-tabs" role="tablist" aria-label="Playground">
    <button type="button" role="tab" id="tab-track" aria-controls="panel-track" aria-selected="true">
      One track
    </button>
    <button type="button" role="tab" id="tab-list" aria-controls="panel-list" aria-selected="false">
      Tracklist
    </button>
  </div>

  <!-- Single track -->
  <section class="pg-panel" id="panel-track" role="tabpanel" aria-labelledby="tab-track">
    <p class="pg-docs">
      Docs:
      <a href={doc("guides/what-it-understands/")}>What it understands</a>
      <a href={doc("reference/parse/")}>parse and ParsedTrack</a>
      <a href={doc("reference/options/")}>Options</a>
      <a href={doc("guides/modes/")}>Modes</a>
    </p>
    <div class="tp-card pg-box">
      <label class="tp-label" for="pg-input">Track string</label>
      <input id="pg-input" class="tp-input" type="text" spellcheck="false" autocomplete="off" />
      <ul class="tp-examples" aria-label="Examples">
        {
          trackExamples.map((e) => (
            <li>
              <button type="button" data-example={e}>
                {e}
              </button>
            </li>
          ))
        }
      </ul>
      <div class="tp-row pg-options">
        <div>
          <label class="tp-label" for="pg-mode"><a class="pg-opt" href={ref.mode}>mode</a></label>
          <select id="pg-mode" class="tp-input">
            <option value="auto">auto</option>
            <option value="clean">clean</option>
            <option value="youtube">youtube</option>
            <option value="filename">filename</option>
            <option value="tracklist">tracklist</option>
          </select>
        </div>
        <div>
          <label class="tp-label" for="pg-split"><a class="pg-opt" href={ref.splitAnd}>splitAnd</a></label>
          <select id="pg-split" class="tp-input">
            <option value="auto">auto</option>
            <option value="always">always</option>
            <option value="never">never</option>
          </select>
        </div>
        <div class="tp-grow">
          <label class="tp-label" for="pg-known"><a class="pg-opt" href={ref.knownArtists}>knownArtists</a> <span class="pg-hint">(comma-separated)</span></label>
          <input id="pg-known" class="tp-input" type="text" spellcheck="false" autocomplete="off" placeholder="Chase & Status, Camo & Krooked" />
        </div>
        <div class="tp-grow">
          <label class="tp-label" for="pg-uploader"><a class="pg-opt" href={ref.uploader}>uploader</a> <span class="pg-hint">(youtube mode)</span></label>
          <input id="pg-uploader" class="tp-input" type="text" spellcheck="false" autocomplete="off" placeholder="Daft Punk - Topic" />
        </div>
      </div>
    </div>

    <div class="tp-card pg-box">
      <p class="tp-line" id="pg-line" aria-live="polite"></p>
      <div class="tp-legend" id="pg-legend"></div>
      <div id="pg-fields"></div>
    </div>

    <div class="pg-split">
      <div class="tp-card pg-box">
        <div class="pg-head">
          <span class="tp-label">Output <span class="tp-mono">ParsedTrack</span></span>
          <button type="button" class="tp-btn small" data-copy="pg-json"><Copy size={14} aria-hidden="true" /><span>Copy JSON</span></button>
        </div>
        <pre class="tp-json" id="pg-json"></pre>
      </div>
      <div class="tp-card pg-box">
        <div class="pg-head">
          <span class="tp-label tp-mono">format(track, options)</span>
          <a class="pg-doc" href={doc("guides/formatting/")}>Formatting guide</a>
        </div>
        <div class="tp-row">
          <div>
            <label class="tp-label" for="pg-feat"><a class="pg-opt" href={ref.feat}>feat</a></label>
            <select id="pg-feat" class="tp-input">
              <option value="source">source</option>
              <option value="artist">artist</option>
              <option value="title">title</option>
              <option value="omit">omit</option>
            </select>
          </div>
          <div>
            <label class="tp-label" for="pg-joiners"><a class="pg-opt" href={ref.joiners}>joiners</a></label>
            <select id="pg-joiners" class="tp-input">
              <option value="original">original</option>
              <option value="canonical">canonical</option>
            </select>
          </div>
          <div>
            <label class="tp-label" for="pg-versions"><a class="pg-opt" href={ref.versions}>versions</a></label>
            <select id="pg-versions" class="tp-input">
              <option value="all">all</option>
              <option value="none">none</option>
            </select>
          </div>
        </div>
        <p class="pg-formatted" id="pg-formatted"></p>
        <div class="pg-head">
          <span class="tp-label">The same call in code</span>
          <span class="pg-lang" role="group" aria-label="Language">
            <button type="button" class="tp-btn small" data-lang="js" aria-pressed="true">JS</button>
            <button type="button" class="tp-btn small" data-lang="py" aria-pressed="false">Python</button>
            <button type="button" class="tp-btn small" data-lang="rs" aria-pressed="false">Rust</button>
            <button type="button" class="tp-btn small" data-lang="go" aria-pressed="false">Go</button>
          </span>
        </div>
        <pre class="tp-json tp-code" id="pg-code"></pre>
        <div class="pg-foot">
          <button type="button" class="tp-btn small" data-copy="pg-code"><Copy size={14} aria-hidden="true" /><span>Copy code</span></button>
          <p class="pg-install" data-install></p>
        </div>
        <p class="pg-install pg-api" id="pg-api"></p>
      </div>
    </div>
  </section>

  <!-- Tracklist -->
  <section class="pg-panel" id="panel-list" role="tabpanel" aria-labelledby="tab-list" hidden>
    <p class="pg-docs">
      Docs:
      <a href={doc("guides/tracklists/")}>Tracklists</a>
      <a href={doc("guides/editing-tracklists/")}>Editing tracklists</a>
      <a href={doc("reference/tracklist/")}>Tracklist API</a>
      <a href={doc("reference/warnings/#tracklist-warnings")}>Warnings</a>
    </p>
    <div class="pg-split pg-list">
      <div class="tp-card pg-box">
        <div class="pg-head">
          <label class="tp-label" for="tl-input">Tracklist text</label>
          <span class="tp-muted" id="tl-meta"></span>
        </div>
        <textarea id="tl-input" class="tp-input" spellcheck="false" data-sample={sample}></textarea>
        <ul class="tp-examples" aria-label="Example tracklists">
          {
            listExamples.map((e, i) => (
              <li>
                <button type="button" data-list-example={e.text} title={e.title} aria-pressed={i === 0 ? "true" : "false"}>
                  {e.label}
                </button>
              </li>
            ))
          }
        </ul>
        <div class="tp-row">
          <div>
            <label class="tp-label" for="tl-audio"><a class="pg-opt" href={ref.audioSeconds}>audioSeconds</a> <span class="pg-hint">(length of the mix)</span></label>
            <input id="tl-audio" class="tp-input pg-num" type="number" min="0" placeholder="–" />
          </div>
          <div class="tp-grow">
            <label class="tp-label" for="tl-known"><a class="pg-opt" href={ref.knownArtists}>knownArtists</a> <span class="pg-hint">(comma-separated)</span></label>
            <input id="tl-known" class="tp-input" type="text" spellcheck="false" autocomplete="off" placeholder="Chase & Status, Camo & Krooked" />
          </div>
        </div>
        <fieldset class="pg-edit">
          <legend class="tp-label"><a class="pg-opt" href={ref.edits}>Edit the text</a></legend>
          <div class="tp-row">
            <div>
              <label class="tp-label" for="tl-shift"><a class="pg-opt" href={ref.shift}>Shift by</a> <span class="pg-hint">(s)</span></label>
              <input id="tl-shift" class="tp-input pg-num" type="number" value="45" />
            </div>
            <div>
              <label class="tp-label" for="tl-from"><a class="pg-opt" href={ref.shift}>from line</a></label>
              <input id="tl-from" class="tp-input pg-num" type="number" min="1" value="5" />
            </div>
            <button type="button" class="tp-btn" id="tl-do-shift"><Timer size={15} aria-hidden="true" /> Shift</button>
          </div>
          <div class="tp-row">
            <button type="button" class="tp-btn" id="tl-do-sort"><ArrowDownWideNarrow size={15} aria-hidden="true" /> Sort by time</button>
            <button type="button" class="tp-btn" id="tl-undo" title="Undo (Ctrl+Z)" disabled><Undo2 size={15} aria-hidden="true" /> Undo</button>
            <button type="button" class="tp-btn" id="tl-redo" title="Redo (Ctrl+Shift+Z)" disabled><Redo2 size={15} aria-hidden="true" /> Redo</button>
            <button type="button" class="tp-btn" data-copy="tl-input"><Copy size={15} aria-hidden="true" /><span>Copy text</span></button>
          </div>
        </fieldset>
        <p class="tp-muted" id="tl-editlog" aria-live="polite"></p>
        <p class="tp-muted" id="tl-urlnote" hidden>This list is too long to keep in the URL. Use Copy text to share it.</p>
      </div>

      <div class="pg-col">
        <div class="tp-card pg-box">
          <div class="tl-stats" id="tl-stats"></div>
          <div id="tl-warnings"></div>
        </div>
        <div class="tp-card pg-box pg-out">
          <div class="pg-head">
            <span class="pg-seg" role="group" aria-label="Output">
              <button type="button" class="tp-btn small" data-view="table" aria-pressed="true">Table</button>
              <button type="button" class="tp-btn small" data-view="json" aria-pressed="false">JSON</button>
              <button type="button" class="tp-btn small" data-view="code" aria-pressed="false">Code</button>
            </span>
            <span class="pg-lang" role="group" aria-label="Language" id="tl-lang" hidden>
              <button type="button" class="tp-btn small" data-lang="js" aria-pressed="true">JS</button>
              <button type="button" class="tp-btn small" data-lang="py" aria-pressed="false">Python</button>
              <button type="button" class="tp-btn small" data-lang="rs" aria-pressed="false">Rust</button>
              <button type="button" class="tp-btn small" data-lang="go" aria-pressed="false">Go</button>
            </span>
            <button type="button" class="tp-btn small" id="tl-copy-out" hidden><Copy size={14} aria-hidden="true" /><span>Copy</span></button>
          </div>
          <pre class="tp-json" id="tl-json" hidden></pre>
          <pre class="tp-json tp-code" id="tl-code" hidden></pre>
          <p class="pg-install" id="tl-install" data-install hidden></p>
          <p class="pg-install pg-api" id="tl-api" hidden></p>
          <div class="pg-tablebox" id="tl-tablebox">
          <table class="tl-table">
            <thead>
              <tr>{columns.map((c) => <th><a href={c.href} title={c.title}>{c.label}</a></th>)}</tr>
            </thead>
            <tbody id="tl-rows"></tbody>
          </table>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

<style>
  .pg,
  .pg-panel,
  .pg-box {
    grid-template-columns: minmax(0, 1fr);
  }
  .pg {
    display: grid;
    gap: 1rem;
  }
  /* Segmented control */
  .pg-tabs {
    display: inline-flex;
    gap: 0.2rem;
    padding: 0.2rem;
    background: var(--tp-surface);
    border: 1px solid var(--tp-border);
    border-radius: var(--tp-radius);
    justify-self: start;
  }
  .pg-tabs button {
    font: 500 0.875rem/1 var(--sl-font);
    color: var(--sl-color-gray-3);
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--tp-radius-sm);
    padding: 0.5rem 0.95rem;
    cursor: pointer;
    transition: color 0.12s, background 0.12s;
  }
  .pg-tabs button:hover {
    color: var(--sl-color-white);
  }
  .pg-tabs button[aria-selected="true"] {
    color: var(--sl-color-white);
    background: var(--tp-surface-2);
    border-color: var(--tp-border);
  }
  .pg-panel {
    display: grid;
    gap: 1rem;
  }
  .pg-panel[hidden] {
    display: none;
  }
  .pg-box {
    padding: clamp(0.9rem, 2.5vw, 1.3rem);
    display: grid;
    gap: 0.8rem;
    min-width: 0;
  }
  .pg-split {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
    gap: 1rem;
    align-items: start;
  }
  .pg-list {
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 72rem) {
    .pg-list {
      grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    }
  }
  .pg-col {
    display: grid;
    gap: 1rem;
    min-width: 0;
  }
  .pg-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .pg-head .tp-label {
    margin: 0;
  }
  /* Quiet links into the docs: one line per mode, and one beside the format options. */
  .pg-docs,
  .pg-install {
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--sl-color-gray-3);
  }
  .pg-docs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.1rem 0.9rem;
  }
  .pg-docs a,
  .pg-doc,
  .pg-install :global(a) {
    color: var(--sl-color-gray-2);
    text-decoration: underline;
    text-decoration-color: var(--tp-border-strong);
    text-underline-offset: 0.2em;
  }
  .pg-docs a:hover,
  .pg-doc:hover,
  .pg-install :global(a:hover) {
    color: var(--sl-color-white);
    text-decoration-color: var(--sl-color-accent);
  }
  .pg-doc {
    font-size: 0.78rem;
  }
  /* Option names and column heads link to their reference rows: the label colour, a quiet
     dotted rule, the accent on hover. */
  .pg-opt,
  .tl-table th a,
  .tl-table :global(.tl-kind a) {
    color: inherit;
    text-decoration: underline dotted;
    text-decoration-color: var(--tp-border-strong);
    text-underline-offset: 0.25em;
  }
  .pg-opt:hover,
  .tl-table th a:hover,
  .tl-table :global(.tl-kind a:hover) {
    color: var(--sl-color-white);
    text-decoration-style: solid;
    text-decoration-color: var(--sl-color-accent);
  }
  /* Every row has a kind: its link shows only on hover, so the column stays quiet. */
  .tl-table :global(.tl-kind a) {
    text-decoration-line: none;
  }
  .tl-table :global(.tl-kind a:hover) {
    text-decoration-line: underline;
  }
  /* The API names under a code panel. */
  .pg-api :global(a) {
    text-decoration: none;
  }
  .pg-api :global(a code) {
    color: var(--sl-color-gray-2);
    border-bottom: 1px solid var(--tp-border-strong);
    border-radius: 4px 4px 0 0;
  }
  .pg-api :global(a:hover code) {
    color: var(--sl-color-white);
    border-bottom-color: var(--sl-color-accent);
  }
  .pg-api[hidden] {
    display: none;
  }
  .pg-api:empty {
    display: none;
  }
  /* Generated Go is indented with tabs, as gofmt writes it. */
  .tp-code {
    tab-size: 4;
  }
  .pg-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.9rem;
  }
  .pg-install :global(code) {
    font: 0.78rem var(--sl-font-mono);
    color: var(--sl-color-gray-1);
    background: var(--tp-code-bg);
    padding: 0.1em 0.35em;
    border-radius: 4px;
    /* The go get line is longer than a phone is wide: it may break anywhere. */
    overflow-wrap: anywhere;
  }
  .pg-install {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.1rem 0.7rem;
    min-width: 0;
  }
  .pg-install[hidden] {
    display: none;
  }
  .pg-install :global(a) {
    white-space: nowrap;
  }
  .pg-options select.tp-input {
    min-width: 8rem;
  }
  /* The edit controls: one quiet group under the parse option. */
  .pg-edit {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 0.75rem 0 0;
    border: 0;
    border-top: 1px solid var(--tp-border);
    min-width: 0;
  }
  .pg-edit legend {
    float: left;
    width: 100%;
    margin-bottom: 0.1rem;
  }
  .pg-hint {
    color: var(--sl-color-gray-4);
    font-weight: 400;
  }
  .tp-input.pg-num {
    width: 7rem;
  }
  .pg-box > .tp-btn {
    justify-self: start;
  }
  .pg-formatted {
    margin: 0;
    font: 500 0.92rem/1.6 var(--sl-font-mono);
    color: var(--sl-color-white);
    overflow-wrap: anywhere;
  }
  /* Small segmented switches: output view (Table / JSON / Code) and language. */
  .pg-lang,
  .pg-seg {
    display: inline-flex;
    gap: 0.3rem;
  }
  .pg-lang[hidden],
  .pg-out [hidden] {
    display: none;
  }
  .pg-lang [aria-pressed="true"],
  .pg-seg [aria-pressed="true"] {
    background: var(--tp-surface-2);
    border-color: var(--sl-color-gray-4);
  }
  .pg-lang [aria-pressed="false"],
  .pg-seg [aria-pressed="false"] {
    color: var(--sl-color-gray-3);
  }
  .pg-out {
    min-width: 0;
  }
  .pg-out .pg-head .pg-seg {
    margin-right: auto;
  }
  .pg-tablebox {
    overflow-x: auto;
  }
  .tl-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
  }
  .tl-table th {
    text-align: left;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--sl-color-gray-3);
    padding: 0.4rem 0.5rem;
    border-bottom: 1px solid var(--tp-border);
  }
  .tl-table :global(td) {
    padding: 0.4rem 0.5rem;
    border-bottom: 1px solid var(--tp-border);
    vertical-align: top;
    overflow-wrap: anywhere;
  }
  /* Artist and title columns keep whole words; only very long tokens break. */
  .tl-table :global(td:nth-child(4)),
  .tl-table :global(td:nth-child(5)) {
    min-width: 7.5rem;
  }
  /* Phones: the kind column gives way to artists and title. */
  @media (max-width: 40rem) {
    .tl-table :global(:is(th, td):nth-child(2)) {
      display: none;
    }
  }
  .tl-table :global(tr.is-warn td:first-child) {
    box-shadow: inset 2px 0 0 var(--tp-featured);
  }
  .tl-table :global(tr.is-changed),
  .tl-table :global(tr.is-target) {
    animation: tl-flash 1.6s ease-out;
  }
  @keyframes tl-flash {
    from {
      background: color-mix(in srgb, var(--sl-color-accent) 16%, transparent);
    }
    to {
      background: transparent;
    }
  }
  .tl-table :global(.tl-num),
  .tl-table :global(.tl-time) {
    font-family: var(--sl-font-mono);
    white-space: nowrap;
    color: var(--sl-color-gray-3);
  }
  .tl-table :global(.tl-time) {
    color: var(--tp-position);
  }
  .tl-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1.1rem;
    font: 0.8rem/1.5 var(--sl-font-mono);
    color: var(--sl-color-gray-2);
  }
  .tl-stats :global(span) {
    white-space: nowrap;
  }
  .tl-table :global(.tl-kind) {
    white-space: nowrap;
    font: 0.78rem/1.9 var(--sl-font-mono);
    color: var(--sl-color-gray-3);
  }
  .tl-table :global(.tl-kind.is-other) {
    color: var(--tp-featured);
  }
  :global(.tl-warning) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.7rem;
    border-radius: var(--tp-radius-sm);
    background: var(--tp-surface-2);
    border: 1px solid var(--tp-border);
    border-left: 2px solid var(--tp-featured);
    font-size: 0.86rem;
    margin-top: 0.5rem;
  }
  :global(.tl-warning.info) {
    border-left-color: var(--sl-color-gray-4);
  }
  :global(.tl-warning > .lucide) {
    color: var(--tp-featured);
    flex: none;
  }
  :global(.tl-warning.info > .lucide) {
    color: var(--sl-color-gray-3);
  }
  :global(.tl-warning a) {
    color: var(--sl-color-white);
    text-decoration-color: color-mix(in srgb, var(--sl-color-accent) 55%, transparent);
    text-underline-offset: 0.2em;
  }
  :global(.tl-warning code) {
    font-size: 0.8rem;
  }
  :global(.tl-warning a.tl-code) {
    text-decoration-color: var(--tp-border-strong);
  }
  :global(.tl-warning a.tl-code:hover) {
    text-decoration-color: var(--sl-color-accent);
  }
  :global(.tl-ok) {
    margin: 0.5rem 0 0;
    color: var(--sl-color-gray-3);
    font-size: 0.86rem;
  }
</style>

<script>
  import { format, parse, type ParseOptions } from "trackparse";
  import { applyEdits, parseTracklist, type Edit, type Tracklist, type TracklistEntry, type TracklistOptions } from "trackparse/tracklist";
  import { icon } from "../lib/icons";
  import { getLang, PACKAGE, setLang, type Lang } from "../lib/lang";
  import { apiUrl, listCode, trackCode, type Snippet } from "../lib/codegen";
  import { chip, codeHtml, GUIDE, escapeHtml, fieldsHtml, highlight, jsonHtml, KIND_LABEL, roleKind, segmentsHtml, type Kind } from "../lib/trackview";

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  /** The site base (`/trackparse`), for links into the docs. */
  const base = document.querySelector<HTMLElement>(".pg")?.dataset.base ?? "";

  // ---- tabs and URL state ------------------------------------------------------------------
  const tabs = { track: $("tab-track"), list: $("tab-list") };
  const panels = { track: $("panel-track"), list: $("panel-list") };
  type Tab = keyof typeof tabs;
  let current: Tab = "track";

  function select(tab: Tab, focus = false) {
    current = tab;
    for (const k of Object.keys(tabs) as Tab[]) {
      tabs[k].setAttribute("aria-selected", String(k === tab));
      tabs[k].tabIndex = k === tab ? 0 : -1;
      panels[k].hidden = k !== tab;
    }
    if (focus) tabs[tab].focus();
    saveHash();
  }
  tabs.track.addEventListener("click", () => select("track"));
  tabs.list.addEventListener("click", () => select("list"));
  for (const t of Object.values(tabs)) {
    t.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight" || e.key === "ArrowLeft") select(current === "track" ? "list" : "track", true);
    });
  }

  let hashTimer = 0;
  function saveHash() {
    clearTimeout(hashTimer);
    hashTimer = window.setTimeout(() => {
      const params = new URLSearchParams();
      if (current === "track") {
        params.set("track", input.value);
        // Options that change the result travel with it, so a shared link shows the same output.
        if (mode.value !== "auto") params.set("mode", mode.value);
        if (split.value !== "auto") params.set("splitAnd", split.value);
        if (known.value.trim()) params.set("known", known.value.trim());
        if (uploader.value.trim()) params.set("uploader", uploader.value.trim());
      } else {
        params.set("list", tl.value);
        if (audio.value !== "") params.set("audioSeconds", audio.value);
        if (tlKnown.value.trim()) params.set("known", tlKnown.value.trim());
      }
      // encodeURIComponent, not URLSearchParams.toString(): spaces stay %20 and `+` is %2B.
      const hash = `#${[...params].map(([k, v]) => `${k}=${encodeURIComponent(v)}`).join("&")}`;
      // Browsers accept huge URLs, but nobody can share one: past this size, keep the URL clean.
      tooLong = hash.length > MAX_HASH;
      $("tl-urlnote").hidden = !(tooLong && current === "list");
      const next = tooLong ? location.pathname : hash;
      const now = tooLong ? location.pathname + location.hash : location.hash;
      if (now !== next) history.replaceState(null, "", next);
    }, 250);
  }
  const MAX_HASH = 8000;
  let tooLong = false;

  // A link to another input while the playground is open (pasted URL, back/forward).
  function loadHash() {
    const params = new URLSearchParams(location.hash.slice(1));
    const t = params.get("track");
    const l = params.get("list");
    // An empty value (a cleared box) keeps the current text but still picks the tab.
    if (t) input.value = t;
    if (l) tl.value = l;
    if (t !== null) {
      const pick = (el: HTMLSelectElement, v: string | null) =>
        (el.value = v !== null && [...el.options].some((o) => o.value === v) ? v : "auto");
      pick(mode, params.get("mode"));
      pick(split, params.get("splitAnd"));
      known.value = params.get("known") ?? "";
      uploader.value = params.get("uploader") ?? "";
    }
    if (l !== null) {
      audio.value = params.get("audioSeconds") ?? "";
      tlKnown.value = params.get("known") ?? "";
    }
    if (t !== null || l !== null) {
      renderTrack();
      renderList();
      select(l !== null ? "list" : "track");
    }
    return params;
  }
  window.addEventListener("hashchange", loadHash);

  // ---- copy buttons ------------------------------------------------------------------------
  for (const b of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
    b.addEventListener("click", async () => {
      const el = $(b.dataset.copy!);
      const text = el instanceof HTMLTextAreaElement ? el.value : (el.textContent ?? "");
      const span = b.querySelector("span") ?? b;
      const label = span.textContent;
      try {
        await navigator.clipboard.writeText(text);
        span.textContent = "Copied";
      } catch {
        span.textContent = "Copy failed";
      }
      setTimeout(() => (span.textContent = label), 1200);
    });
  }

  // ---- single track ------------------------------------------------------------------------
  const input = $<HTMLInputElement>("pg-input");
  const mode = $<HTMLSelectElement>("pg-mode");
  const split = $<HTMLSelectElement>("pg-split");
  const known = $<HTMLInputElement>("pg-known");
  const uploader = $<HTMLInputElement>("pg-uploader");
  const feat = $<HTMLSelectElement>("pg-feat");
  const joiners = $<HTMLSelectElement>("pg-joiners");
  const versions = $<HTMLSelectElement>("pg-versions");
  // The language of both code panels: the one last picked here, in the install switch on the
  // landing page or in any code tab of the docs.
  let lang: Lang = getLang();

  /** The install line under a code panel, with links to the install guide and the registry. */
  function showLang() {
    for (const x of document.querySelectorAll<HTMLElement>("[data-lang]"))
      x.setAttribute("aria-pressed", String(x.dataset.lang === lang));
    const p = PACKAGE[lang];
    const html =
      `<span>Install: <code>${escapeHtml(p.install)}</code></span>` +
      `<a href="${base}/start/getting-started/">Getting started</a>` +
      `<a href="${p.url}">${p.registry}</a>` +
      // The API docs: docs.rs for the crate, pkg.go.dev (the link above) for the module, and
      // this site's reference for the npm and PyPI packages.
      (lang === "rs"
        ? '<a href="https://docs.rs/trackparse">docs.rs</a>'
        : lang === "go"
          ? ""
          : `<a href="${base}/reference/parse/">API reference</a>`);
    for (const el of document.querySelectorAll<HTMLElement>("[data-install]")) el.innerHTML = html;
  }

  /** Under a code panel: each function and type the snippet uses, linked to its API docs. */
  function apiHtml(snippet: Snippet): string {
    const where = lang === "rs" ? "docs.rs" : lang === "go" ? "pkg.go.dev" : "the reference";
    const links = snippet.api
      .map((name) => [name, apiUrl(lang, name, base)] as const)
      .filter(([, url]) => url)
      .map(([name, url]) => `<a href="${url}" title="${escapeHtml(name)} on ${where}"><code>${escapeHtml(name)}</code></a>`);
    return links.length ? `<span>API docs:</span>${links.join("")}` : "";
  }

  function options(): ParseOptions {
    const o: ParseOptions = {};
    if (mode.value !== "auto") o.mode = mode.value as ParseOptions["mode"];
    if (split.value !== "auto") o.splitAnd = split.value as ParseOptions["splitAnd"];
    const names = known.value.split(",").map((s) => s.trim()).filter(Boolean);
    if (names.length) o.knownArtists = names;
    if (uploader.value.trim()) o.uploader = uploader.value.trim();
    return o;
  }

  function renderTrack() {
    const s = input.value;
    const o = options();
    const track = parse(s, o);
    const segs = highlight(s, track);
    $("pg-line").innerHTML = segmentsHtml(segs) || '<span class="tp-gap">type a track name</span>';
    const kinds = [...new Set(segs.map((x) => x.kind).filter(Boolean))] as Kind[];
    $("pg-legend").innerHTML = kinds.map((k) => chip(KIND_LABEL[k], k)).join("");
    $("pg-fields").innerHTML = fieldsHtml(track, base);
    $("pg-json").innerHTML = jsonHtml(track);
    const f: Record<string, unknown> = {};
    if (feat.value !== "source") f.feat = feat.value;
    if (joiners.value !== "original") f.joiners = joiners.value;
    if (versions.value !== "all") f.versions = versions.value;
    $("pg-formatted").textContent = format(track, f) || "–";
    const snippet = trackCode(lang, s, o, f);
    $("pg-code").innerHTML = codeHtml(snippet.src, lang);
    $("pg-api").innerHTML = apiHtml(snippet);
    for (const b of document.querySelectorAll<HTMLButtonElement>("#panel-track [data-example]")) {
      b.setAttribute("aria-pressed", String(b.dataset.example === s));
    }
    saveHash();
  }

  for (const el of [input, known, uploader]) el.addEventListener("input", renderTrack);
  for (const el of [mode, split, feat, joiners, versions]) el.addEventListener("change", renderTrack);
  for (const b of document.querySelectorAll<HTMLButtonElement>("#panel-track [data-example]")) {
    b.addEventListener("click", () => {
      input.value = b.dataset.example ?? "";
      mode.value = input.value.startsWith('"') ? "youtube" : "auto";
      renderTrack();
    });
  }
  // One language choice for both code panels.
  for (const b of document.querySelectorAll<HTMLButtonElement>("[data-lang]")) {
    b.addEventListener("click", () => {
      lang = b.dataset.lang as Lang;
      setLang(lang);
      showLang();
      renderTrack();
      renderList();
    });
  }

  // ---- tracklist ---------------------------------------------------------------------------
  const tl = $<HTMLTextAreaElement>("tl-input");
  const audio = $<HTMLInputElement>("tl-audio");
  const tlKnown = $<HTMLInputElement>("tl-known");
  const undoBtn = $<HTMLButtonElement>("tl-undo");
  const redoBtn = $<HTMLButtonElement>("tl-redo");

  // One history for the tracklist box: typing, edits, examples and opened links. Setting
  // `textarea.value` from a script clears the browser's own undo history, so the page keeps its
  // own and Ctrl+Z / Ctrl+Shift+Z use it too.
  interface Step {
    text: string;
    label: string;
  }
  const MAX_STEPS = 100;
  const past: Step[] = [];
  const future: Step[] = [];
  /** The text as of the last step (what Undo of the next step goes back to). */
  let settled = "";
  /** A run of typing is one step; it ends after a pause. */
  let typingOpen = false;
  let typingTimer = 0;

  function syncHistoryButtons() {
    undoBtn.disabled = past.length === 0;
    redoBtn.disabled = future.length === 0;
  }
  /** Record a step that leads away from the settled text. */
  function pushStep(label: string) {
    past.push({ text: settled, label });
    if (past.length > MAX_STEPS) past.shift();
    future.length = 0;
  }
  /** Replace the text from the page (an edit, an example, a link) as one undoable step. */
  function setText(text: string, label: string) {
    typingOpen = false;
    if (text !== settled) pushStep(label);
    tl.value = text;
    settled = text;
    syncHistoryButtons();
  }
  function stepBack(from: Step[], to: Step[], word: string) {
    const step = from.pop();
    if (!step) return;
    typingOpen = false;
    to.push({ text: tl.value, label: step.label });
    tl.value = step.text;
    settled = step.text;
    syncHistoryButtons();
    $("tl-editlog").textContent = `${word}: ${step.label}.`;
    renderList();
  }
  const undo = () => stepBack(past, future, "Undone");
  const redo = () => stepBack(future, past, "Redone");
  let changed = new Set<number>();


  function listOptions(): TracklistOptions {
    const o: TracklistOptions = {};
    const n = Number(audio.value);
    if (audio.value !== "" && Number.isFinite(n)) o.audioSeconds = n;
    const names = tlKnown.value.split(",").map((s) => s.trim()).filter(Boolean);
    if (names.length) o.knownArtists = names;
    return o;
  }

  function row(e: TracklistEntry, warn: boolean): string {
    const t = e.track;
    const artists = t
      ? t.artists
          .map((a) => (a.role !== "primary" ? `${escapeHtml(a.name)} ${chip(a.role, roleKind(a), `The ${a.role} role`, `${base}/${GUIDE.role[a.role]}`)}` : escapeHtml(a.name)))
          .join(", ")
      : "";
    const title = t ? escapeHtml(t.title) : `<span class="tp-none">${escapeHtml(e.raw.trim())}</span>`;
    const vers = t
      ? t.versions.map((v) => chip(v.artists[0] ? `${v.type} · ${v.artists[0].name}` : v.type, "version", "The version types", `${base}/${GUIDE.versionType}`)).join(" ")
      : "";
    const pos = t?.position ? `${chip(`#${t.position.number}`, "position", "Track numbers in a tracklist", `${base}/guides/tracklists/#bare-track-numbers`)} ` : "";
    // R13.13: a `w/` line plays over the previous track.
    const layered = e.layered ? `${chip("w/", "layered", "Layered: played over the previous track", `${base}/guides/tracklists/#layered-tracks`)} ` : "";
    const cls = [warn ? "is-warn" : "", changed.has(e.line) ? "is-changed" : ""].join(" ").trim();
    return `<tr class="${cls}" id="tl-line-${e.line}"><td class="tl-num">${e.line}</td><td class="tl-kind${e.kind === "track" ? "" : " is-other"}"><a href="${base}/guides/tracklists/#line-kinds" title="Line kinds">${e.kind}</a></td><td class="tl-time">${e.time ? escapeHtml(e.time.raw) : ""}</td><td>${layered}${pos}${artists}</td><td>${title}</td><td>${vers}</td></tr>`;
  }

  function plural(n: number, word: string): string {
    return `${n} ${word}${n === 1 ? "" : "s"}`;
  }

  /** 1, 2, 3, 5, 7, 8 → "1–3, 5, 7–8" */
  function ranges(lines: number[]): string {
    const out: string[] = [];
    for (let i = 0; i < lines.length; ) {
      let j = i;
      while (j + 1 < lines.length && lines[j + 1] === lines[j] + 1) j++;
      out.push(j === i ? String(lines[i]) : `${lines[i]}–${lines[j]}`);
      i = j + 1;
    }
    return out.length > 12 ? `${out.slice(0, 12).join(", ")} and ${out.length - 12} more` : out.join(", ");
  }

  function fmtTime(s: number | null): string {
    if (s === null) return "–";
    const h = Math.floor(s / 3600);
    const m = Math.floor((s % 3600) / 60);
    const sec = Math.floor(s % 60);
    return `${h ? `${h}:` : ""}${String(m).padStart(h ? 2 : 1, "0")}:${String(sec).padStart(2, "0")}`;
  }

  /** "Shift by": an empty or unreadable box is 0, in the button and in the generated code. */
  const shiftSeconds = () => Number(($("tl-shift") as HTMLInputElement).value) || 0;
  const lineCount = () => tl.value.split(/\r\n|\r|\n/).length;
  /** "from line", kept between 1 and the last line. */
  function shiftFrom(): number {
    const v = Math.trunc(Number(($("tl-from") as HTMLInputElement).value)) || 1;
    return Math.min(Math.max(v, 1), lineCount());
  }

  // The tracklist output: the table, the raw JSON, or the same calls as code.
  type View = "table" | "json" | "code";
  let view: View = "table";

  function showView() {
    for (const b of document.querySelectorAll<HTMLElement>("[data-view]")) b.setAttribute("aria-pressed", String(b.dataset.view === view));
    $("tl-tablebox").hidden = view !== "table";
    $("tl-json").hidden = view !== "json";
    $("tl-code").hidden = view !== "code";
    $("tl-lang").hidden = view !== "code";
    $("tl-install").hidden = view !== "code";
    $("tl-api").hidden = view !== "code";
    $("tl-copy-out").hidden = view === "table";
  }

  function renderList() {
    const text = tl.value;
    const t0 = performance.now();
    const list = parseTracklist(text, listOptions());
    const ms = performance.now() - t0;
    const warned = new Set(list.warnings.map((w) => w.line));
    $("tl-rows").innerHTML = list.entries.map((e) => row(e, warned.has(e.line))).join("");
    // Only the visible view is rendered: JSON of a long list is large.
    if (view === "json") $("tl-json").innerHTML = jsonHtml(list);
    if (view === "code") {
      const fix = list.warnings.find((w) => w.suggestion)?.suggestion;
      const snippet = listCode(lang, {
        text,
        ...listOptions(),
        seconds: shiftSeconds(),
        from: shiftFrom(),
        fix: fix && { line: fix.line, seconds: fix.seconds },
      });
      $("tl-code").innerHTML = codeHtml(snippet.src, lang);
      $("tl-api").innerHTML = apiHtml(snippet);
    }
    for (const b of document.querySelectorAll<HTMLButtonElement>("[data-list-example]"))
      b.setAttribute("aria-pressed", String(b.dataset.listExample === text));
    const st = list.stats;
    $("tl-stats").innerHTML = [
      plural(st.lines, "line"),
      plural(st.tracks, "track"),
      plural(st.markers, "marker"),
      `${st.timed} timed`,
      `${fmtTime(st.firstTime)} → ${fmtTime(st.lastTime)}`,
    ]
      .map((x) => `<span>${escapeHtml(x)}</span>`)
      .join("");
    $("tl-meta").textContent = `parsed in ${ms < 1 ? "<1" : ms.toFixed(1)} ms`;
    $("tl-warnings").innerHTML = list.warnings.length
      ? list.warnings
          .map((w, i) => {
            const fix = w.suggestion
              ? ` <button type="button" class="tp-btn small primary" data-fix="${i}">${icon.fix} Set line ${w.suggestion.line} to ${escapeHtml(w.suggestion.raw)}</button>`
              : "";
            // The code links to its row in the warnings reference (a text fragment finds the row).
            const ref = `${base}/reference/warnings/#tracklist-warnings:~:text=${encodeURIComponent(w.code).replaceAll("-", "%2D")}`;
            return `<div class="tl-warning ${w.severity}">${w.severity === "info" ? icon.info : icon.warning}<a href="#tl-line-${w.line}" data-line="${w.line}">line ${w.line}</a> <a class="tl-code" href="${ref}" title="What ${w.code} means"><code>${w.code}</code></a>${fix}</div>`;
          })
          .join("")
      :  `<p class="tl-ok">${st.timed > 1 ? "No warnings. Times are in order." : "No warnings."}</p>`;
    for (const a of $("tl-warnings").querySelectorAll<HTMLAnchorElement>("a[data-line]")) {
      a.addEventListener("click", (e) => {
        e.preventDefault();
        const tr = $(`tl-line-${a.dataset.line}`);
        if (!tr) return;
        tr.classList.remove("is-target");
        void tr.offsetWidth;
        tr.classList.add("is-target");
        tr.scrollIntoView({ block: "center", behavior: "smooth" });
      });
    }
    for (const b of document.querySelectorAll<HTMLButtonElement>("[data-fix]")) {
      b.addEventListener("click", () => {
        const s = list.warnings[Number(b.dataset.fix)].suggestion;
        if (s) edit([{ op: "set-time", line: s.line, seconds: s.seconds }], `Set line ${s.line} to ${s.raw}`);
      });
    }
    saveHash();
  }

  function edit(edits: Edit[], label: string) {
    const r = applyEdits(tl.value, edits);
    const same = r.text === tl.value;
    if (!same) {
      setText(r.text, label);
      changed = new Set(r.changed);
    }
    const NOTE: Record<string, string> = {
      "edit-invalid": "the edit can't apply here",
      "time-clamped": "a time stopped at zero",
      "style-upgraded": "a time gained hours",
    };
    const notes = [...new Set(r.warnings.map((w) => NOTE[w.code] ?? w.code))].join(", ");
    const what = same ? "nothing changed" : `changed ${r.changed.length > 1 ? "lines" : "line"} ${ranges(r.changed)}`;
    $("tl-editlog").textContent = `${label}: ${what}${notes ? ` (${notes})` : ""}.`;
    renderList();
    changed = new Set();
  }

  let typing = 0;
  tl.addEventListener("input", () => {
    $("tl-editlog").textContent = "";
    // A run of typing is one undo step, closed by a pause.
    if (!typingOpen && tl.value !== settled) {
      pushStep("typing");
      typingOpen = true;
    }
    settled = tl.value;
    clearTimeout(typingTimer);
    typingTimer = window.setTimeout(() => (typingOpen = false), 600);
    syncHistoryButtons();
    // Short lists re-parse on every key; long ones wait for a pause in typing.
    clearTimeout(typing);
    if (tl.value.length < 20000) renderList();
    else typing = window.setTimeout(renderList, 250);
  });
  audio.addEventListener("input", renderList);
  tlKnown.addEventListener("input", renderList);
  $("tl-do-shift").addEventListener("click", () => {
    const seconds = shiftSeconds();
    const from = shiftFrom();
    edit([{ op: "shift", seconds, from }], `Shift ${seconds >= 0 ? "+" : ""}${seconds} s from line ${from}`);
  });
  $("tl-do-sort").addEventListener("click", () => edit([{ op: "sort-by-time" }], "Sort by time"));
  undoBtn.addEventListener("click", undo);
  redoBtn.addEventListener("click", redo);
  tl.addEventListener("keydown", (e) => {
    if (!(e.ctrlKey || e.metaKey) || e.altKey) return;
    const k = e.key.toLowerCase();
    if (k !== "z" && k !== "y") return;
    e.preventDefault();
    if (k === "y" || e.shiftKey) redo();
    else undo();
  });
  // An example replaces the text; Undo brings the old text back.
  function loadSample(text: string | undefined, label = "example") {
    setText(text ?? "", `Load ${label}`);
    audio.value = "";
    tlKnown.value = "";
    // Keep "from line" inside the new list, so Shift and the generated code stay valid.
    const fromEl = $<HTMLInputElement>("tl-from");
    if (Number(fromEl.value) > lineCount()) fromEl.value = String(Math.min(2, lineCount()));
    changed.clear();
    $("tl-editlog").textContent = "";
    renderList();
  }
  for (const b of document.querySelectorAll<HTMLButtonElement>("[data-list-example]"))
    b.addEventListener("click", () => loadSample(b.dataset.listExample, `the "${b.textContent?.trim()}" example`));
  for (const b of document.querySelectorAll<HTMLButtonElement>("[data-view]")) {
    b.addEventListener("click", () => {
      view = b.dataset.view as View;
      showView();
      renderList();
    });
  }
  $("tl-copy-out").addEventListener("click", async () => {
    const btn = $("tl-copy-out");
    const span = btn.querySelector("span") ?? btn;
    try {
      await navigator.clipboard.writeText($(view === "json" ? "tl-json" : "tl-code").textContent ?? "");
      span.textContent = "Copied";
    } catch {
      span.textContent = "Copy failed";
    }
    setTimeout(() => (span.textContent = "Copy"), 1200);
  });
  for (const id of ["tl-shift", "tl-from"]) $(id).addEventListener("input", () => view === "code" && renderList());

  // ---- start -------------------------------------------------------------------------------
  input.value = document.querySelector<HTMLButtonElement>("[data-example]")?.dataset.example ?? "";
  tl.value = tl.dataset.sample ?? "";
  showLang();
  const params = loadHash();
  if (!params.has("track") && !params.has("list")) {
    renderTrack();
    renderList();
    select("track");
  }
  // History starts from whatever the page opened with.
  past.length = 0;
  settled = tl.value;
  syncHistoryButtons();
</script>
