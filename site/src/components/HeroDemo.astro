---
import ArrowRight from "@lucide/astro/icons/arrow-right";
import "../styles/playground.css";

const examples = [
  "01. Wilkinson ft. Becky Hill & Tom Cane - Afterglow (Sub Focus VIP Remix) [Official Video]",
  "Skrillex & Diplo x Justin Bieber - Where Are Ü Now",
  "Future - Mask Off (prod. by Metro Boomin)",
  "The Beatles - Hey Jude - Remastered 2015",
  "07_Burial_-_Archangel.mp3",
  "Кино - Группа крови (Remastered 2019)",
  "ID - ID (ID Remix)",
];
const playground = `${import.meta.env.BASE_URL}playground/`;
---

<section class="hero-demo tp-card not-content" data-playground={playground} aria-label="Live demo">
  <header class="hd-bar">
    <span class="hd-title"><span class="tp-mono">parse(input)</span><span class="hd-sub">runs the real package in your browser</span></span>
    <span class="tp-muted tp-mono hd-time" id="hd-time"></span>
  </header>
  <div class="hd-body">
    <label class="sr-only" for="hd-input">Track name</label>
    <input
      id="hd-input"
      class="tp-input"
      type="text"
      value={examples[0]}
      spellcheck="false"
      autocomplete="off"
    />
    <ul class="tp-examples" aria-label="Examples">
      {
        examples.map((e, i) => (
          <li>
            <button type="button" data-example={e} aria-pressed={i === 0 ? "true" : "false"}>
              {e}
            </button>
          </li>
        ))
      }
    </ul>
  </div>
  <div class="hd-out">
    <p class="tp-line" id="hd-line" aria-live="polite"></p>
    <div class="tp-legend" id="hd-legend"></div>
    <div id="hd-fields"></div>
  </div>
  <footer class="hd-foot">
    <a class="hd-open" id="hd-open" href={playground}>Open in the playground <ArrowRight size={14} aria-hidden="true" /></a>
  </footer>
</section>

<style>
  .hero-demo,
  .hd-body,
  .hd-out {
    min-width: 0;
  }
  .hero-demo {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin-block: 3rem 0;
    overflow: hidden;
  }
  .hd-bar,
  .hd-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.65rem 1.1rem;
    font-size: 0.8rem;
  }
  .hd-bar {
    border-bottom: 1px solid var(--tp-border);
    background: var(--tp-surface-2);
  }
  .hd-title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    color: var(--sl-color-white);
  }
  .hd-sub {
    color: var(--sl-color-gray-3);
  }
  .hd-time {
    white-space: nowrap;
  }
  /* Phones: examples become one scrolling row instead of a tall stack. */
  @media (max-width: 40rem) {
    .hd-body .tp-examples {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      margin-inline: -1.1rem;
      padding-inline: 1.1rem;
      scroll-padding-inline: 1.1rem;
    }
    .hd-body .tp-examples::-webkit-scrollbar {
      display: none;
    }
    .hd-body .tp-examples li {
      flex: none;
      max-width: 80vw;
    }
  }
  .hd-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
    padding: 1.1rem;
  }
  .hd-out {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.9rem;
    padding: 0.4rem 1.1rem 1.1rem;
  }
  .hd-foot {
    justify-content: flex-end;
    border-top: 1px solid var(--tp-border);
  }
  .hd-open {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 500;
    color: var(--sl-color-white);
    text-decoration: none;
  }
  .hd-open:hover {
    color: var(--sl-color-accent-high);
  }
  :global([data-theme="light"]) .hd-open:hover {
    color: var(--sl-color-accent);
  }
</style>

<script>
  import { parse } from "trackparse";
  import { chip, fieldsHtml, highlight, KIND_LABEL, segmentsHtml, type Kind } from "../lib/trackview";

  const root = document.querySelector<HTMLElement>(".hero-demo");
  if (root) {
    const input = root.querySelector<HTMLInputElement>("#hd-input")!;
    const line = root.querySelector<HTMLElement>("#hd-line")!;
    const legend = root.querySelector<HTMLElement>("#hd-legend")!;
    const fields = root.querySelector<HTMLElement>("#hd-fields")!;
    const open = root.querySelector<HTMLAnchorElement>("#hd-open")!;
    const time = root.querySelector<HTMLElement>("#hd-time")!;
    const buttons = [...root.querySelectorAll<HTMLButtonElement>("[data-example]")];
    const base = root.dataset.playground ?? "playground/";

    const render = () => {
      const s = input.value;
      const t0 = performance.now();
      const track = parse(s);
      const ms = performance.now() - t0;
      const segs = highlight(s, track);
      line.innerHTML = segmentsHtml(segs) || '<span class="tp-gap">type a track name</span>';
      const kinds = [...new Set(segs.map((x) => x.kind).filter(Boolean))] as Kind[];
      legend.innerHTML = kinds.map((k) => chip(KIND_LABEL[k], k)).join("");
      fields.innerHTML = fieldsHtml(track);
      open.href = `${base}#track=${encodeURIComponent(s)}`;
      time.textContent = `${ms < 1 ? "<1" : ms.toFixed(1)} ms`;
      for (const b of buttons) b.setAttribute("aria-pressed", String(b.dataset.example === s));
    };

    input.addEventListener("input", render);
    for (const b of buttons) {
      b.addEventListener("click", () => {
        input.value = b.dataset.example ?? "";
        render();
      });
    }
    render();
  }
</script>
