---
// One install line under the hero, switchable between npm, pip, cargo and go, with a copy button.
// The switch shares its choice with the docs' language tabs and the playground (lib/lang.ts).
import Check from "@lucide/astro/icons/check";
import Copy from "@lucide/astro/icons/copy";
import { PACKAGE } from "../lib/lang";

const pms = [
  { lang: "js", label: "npm" },
  { lang: "py", label: "pip" },
  { lang: "rs", label: "cargo" },
  { lang: "go", label: "go" },
] as const;
---

<div class="install-wrap not-content">
  <div class="install">
    <div class="seg" role="group" aria-label="Package manager">
      {
        pms.map((p, i) => (
          <button type="button" data-pm={p.lang} data-cmd={PACKAGE[p.lang].install} aria-pressed={i === 0 ? "true" : "false"}>
            {p.label}
          </button>
        ))
      }
    </div>
    <code><span class="prompt" aria-hidden="true">$</span> <span class="cmd">{PACKAGE.js.install}</span></code>
    <button type="button" class="copy" aria-label="Copy the install command"><Copy size={15} class="i-copy" aria-hidden="true" /><Check size={15} class="i-check" aria-hidden="true" /></button>
  </div>
  <p class="pkgs">
    Published on <a href={PACKAGE.js.url}>npm</a>, <a href={PACKAGE.py.url}>PyPI</a> and{" "}
    <a href={PACKAGE.rs.url}>crates.io</a>. The Rust API docs are on <a href="https://docs.rs/trackparse">docs.rs</a>.
    The Go module is published from the next release, with its docs on <a href={PACKAGE.go.url}>pkg.go.dev</a>.
  </p>
</div>

<style>
  .install-wrap {
    margin-top: 1.75rem;
  }
  .install {
    display: inline-flex;
    align-items: center;
    max-width: 100%;
    border: 1px solid var(--tp-border);
    border-radius: var(--tp-radius);
    background: var(--tp-surface);
    font: 0.85rem/1 var(--sl-font-mono);
  }
  .seg {
    display: flex;
    padding: 0.25rem;
    gap: 0.15rem;
    border-right: 1px solid var(--tp-border);
  }
  .seg button {
    font: 500 0.75rem/1 var(--sl-font-mono);
    color: var(--sl-color-gray-3);
    background: transparent;
    border: 0;
    border-radius: 4px;
    padding: 0.45rem 0.55rem;
    cursor: pointer;
  }
  .seg button[aria-pressed="true"] {
    color: var(--sl-color-white);
    background: var(--tp-surface-2);
  }
  code {
    padding: 0 0.9rem;
    color: var(--sl-color-white);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    background: none;
    border: 0;
    font-size: inherit;
  }
  .prompt {
    color: var(--sl-color-gray-4);
  }
  .copy {
    display: grid;
    place-items: center;
    align-self: stretch;
    padding: 0 0.8rem;
    color: var(--sl-color-gray-3);
    background: transparent;
    border: 0;
    border-left: 1px solid var(--tp-border);
    cursor: pointer;
  }
  .copy:hover,
  .copy.done {
    color: var(--sl-color-white);
  }
  .copy :global(.i-check),
  .copy.done :global(.i-copy) {
    display: none;
  }
  .copy.done :global(.i-check) {
    display: block;
  }
  .pkgs {
    margin: 0.7rem 0 0;
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--sl-color-gray-3);
  }
  .pkgs a {
    color: var(--sl-color-gray-2);
    text-decoration: underline;
    text-decoration-color: var(--tp-border-strong);
    text-underline-offset: 0.2em;
  }
  .pkgs a:hover {
    color: var(--sl-color-white);
    text-decoration-color: var(--sl-color-accent);
  }
  /* Four package managers and a command don't fit one row on a phone: the switch gets its own. */
  @media (max-width: 26rem) {
    .install {
      flex-wrap: wrap;
    }
    .seg {
      flex-basis: 100%;
      border-right: 0;
      border-bottom: 1px solid var(--tp-border);
    }
    code {
      flex: 1;
      padding-block: 0.8rem;
    }
  }
</style>

<script>
  import { getLang, onDocsLang, setLang, type Lang } from "../lib/lang";

  for (const root of document.querySelectorAll<HTMLElement>(".install")) {
    const cmd = root.querySelector<HTMLElement>(".cmd")!;
    const copy = root.querySelector<HTMLButtonElement>(".copy")!;
    const buttons = [...root.querySelectorAll<HTMLButtonElement>("[data-pm]")];
    const show = (lang: Lang) => {
      for (const b of buttons) {
        b.setAttribute("aria-pressed", String(b.dataset.pm === lang));
        if (b.dataset.pm === lang) cmd.textContent = b.dataset.cmd ?? "";
      }
    };
    for (const b of buttons) {
      b.addEventListener("click", () => {
        show(b.dataset.pm as Lang);
        setLang(b.dataset.pm as Lang);
      });
    }
    // The language picked earlier, here or in any code tab of the docs.
    show(getLang());
    onDocsLang(show);
    copy.addEventListener("click", async () => {
      let label = "Copied";
      try {
        await navigator.clipboard.writeText(cmd.textContent ?? "");
        copy.classList.add("done");
      } catch {
        label = "Copy failed";
      }
      copy.setAttribute("aria-label", label);
      setTimeout(() => {
        copy.classList.remove("done");
        copy.setAttribute("aria-label", "Copy the install command");
      }, 1200);
    });
  }
</script>
