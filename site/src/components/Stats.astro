---
// Monochrome numbers in one row. Keep them in sync with the fixtures (see AGENTS.md).
const stats = [
  { n: "12,965", label: "shared fixtures, 100% passing in both ports" },
  { n: "0", label: "runtime dependencies" },
  { n: "27", label: "version types, remix to nightcore" },
  { n: "0", label: "differences between JS and Python output" },
];
---

<dl class="stats not-content">
  {
    stats.map((s) => (
      <div class="stat">
        <dt>{s.label}</dt>
        <dd>{s.n}</dd>
      </div>
    ))
  }
</dl>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 3rem 0 0;
    border-top: 1px solid var(--tp-border);
    border-bottom: 1px solid var(--tp-border);
  }
  .stat {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.35rem;
    padding: 1.4rem 1.25rem 1.4rem 0;
    min-width: 0;
  }
  .stat + .stat {
    padding-left: 1.25rem;
    border-left: 1px solid var(--tp-border);
  }
  .stat dd {
    margin: 0;
    font: 500 clamp(1.6rem, 3.2vw, 2.1rem) / 1 var(--sl-font-mono);
    letter-spacing: -0.04em;
    color: var(--sl-color-white);
    font-variant-numeric: tabular-nums;
  }
  .stat dt {
    font-size: 0.82rem;
    line-height: 1.4;
    color: var(--sl-color-gray-3);
  }
  @media (max-width: 50rem) {
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .stat:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }
    .stat:nth-child(n + 3) {
      border-top: 1px solid var(--tp-border);
    }
  }
</style>
