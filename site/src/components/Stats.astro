---
import FlaskConical from "@lucide/astro/icons/flask-conical";
import GitCompare from "@lucide/astro/icons/git-compare";
import Layers from "@lucide/astro/icons/layers";
import Package from "@lucide/astro/icons/package";

const stats = [
  { n: "12,965", label: "shared fixtures", note: "100% pass in JS and Python", icon: FlaskConical },
  { n: "0", label: "dependencies", note: "ESM, CJS and types", icon: Package },
  { n: "27", label: "version types", note: "remix to nightcore", icon: Layers },
  { n: "0", label: "differences", note: "between the JS and Python output", icon: GitCompare },
];
---

<section class="stats not-content" aria-label="Numbers">
  {
    stats.map((s) => (
      <div class="stat">
        <span class="stat-icon" aria-hidden="true"><s.icon size={18} strokeWidth={2} /></span>
        <span class="n">{s.n}</span>
        <span class="label">{s.label}</span>
        <span class="note">{s.note}</span>
      </div>
    ))
  }
</section>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
    gap: 1px;
    margin-block: 3rem 1rem;
    background: var(--tp-border);
    border: 1px solid var(--tp-border);
    border-radius: 1rem;
    overflow: hidden;
  }
  .stat {
    display: grid;
    gap: 0.15rem;
    padding: 1.2rem 1.3rem;
    background: var(--tp-surface);
  }
  .stat-icon {
    color: var(--sl-color-gray-3);
    margin-bottom: 0.4rem;
  }
  .n {
    font: 700 2.2rem/1 "Space Grotesk Variable", var(--sl-font);
    letter-spacing: -0.03em;
    color: var(--sl-color-accent);
  }
  .label {
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .note {
    font-size: 0.82rem;
    color: var(--sl-color-gray-3);
  }
</style>
