# Fails when LIBRARY defines a global symbol whose name does not start with trackparse_.
#   cmake -DLIBRARY=... -DNM=... -DSHARED=ON|OFF -DAPPLE=1|"" -P check_exports.cmake
# Prints "SKIP:" (the test's skip pattern) where there is no nm, or for a DLL.
if(NOT NM OR LIBRARY MATCHES "\\.(dll|lib)$")
  message("SKIP: no nm, or a Windows library (the Windows DLL is built and linked by CI's windows-msvc-shared job)")
  return()
endif()
if(SHARED AND NOT APPLE)
  set(args -D --defined-only)
elseif(APPLE)
  set(args -g -U)
else()
  set(args -g --defined-only)
endif()
execute_process(COMMAND "${NM}" ${args} "${LIBRARY}" RESULT_VARIABLE rc OUTPUT_VARIABLE out
  ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "${NM} ${args} ${LIBRARY} failed: ${err}")
endif()
string(REPLACE "\n" ";" lines "${out}")
set(count 0)
set(bad "")
foreach(line IN LISTS lines)
  # "address type name"; skip archive member headers ("file.o:") and empty lines.
  if(NOT line MATCHES "^[0-9A-Fa-f]* *([A-Za-z]) ([^ ]+)$")
    continue()
  endif()
  set(type "${CMAKE_MATCH_1}")
  set(name "${CMAKE_MATCH_2}")
  if(type STREQUAL "U" OR type STREQUAL "w" OR type STREQUAL "v")
    continue()
  endif()
  if(APPLE)
    string(REGEX REPLACE "^_" "" name "${name}")
  endif()
  # Linker-made symbols of a shared object, and what a sanitizer build adds.
  if(name MATCHES "^(_init|_fini|_edata|_end|__bss_start|_DYNAMIC|_GLOBAL_OFFSET_TABLE_)$"
     OR name MATCHES "^_*(asan|ubsan|tsan|msan|sancov|sanitizer)_")
    continue()
  endif()
  if(name MATCHES "^trackparse_")
    math(EXPR count "${count} + 1")
  else()
    list(APPEND bad "${type} ${name}")
  endif()
endforeach()
if(bad)
  string(REPLACE ";" "\n  " bad "${bad}")
  message(FATAL_ERROR "${LIBRARY} exports symbols outside trackparse_*:\n  ${bad}")
endif()
if(count EQUAL 0)
  message(FATAL_ERROR "${LIBRARY}: no trackparse_* symbols found (nm output:\n${out})")
endif()
message(STATUS "${LIBRARY}: ${count} symbols, all trackparse_*")
